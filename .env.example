# Copy to .env and fill in on the machine that runs profile=server.
# Never commit the real .env file.

# Root directory containing CHB-MIT raw .edf files on the training server.
CHBMIT_RAW_DIR=/path/to/chbmit/raw

# Directory where checkpoints, logs and result summaries are written on the server.
WEARSEIZURE_ARTIFACTS_DIR=/path/to/artifacts
