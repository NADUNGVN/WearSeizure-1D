# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

# Env
.env

# Data (never commit raw clinical data or generated artifacts)
data/raw/
data/synthetic/generated/
data/splits/*.json
!data/splits/.gitkeep
*.edf
*.edf.gz

# Artifacts / checkpoints / logs
artifacts/
outputs/
multirun/
*.pt
*.pth
*.ckpt
results/
wandb/
mlruns/
# Run logs. The section header has said "logs" since the start without ever
# ignoring one, so every long run left another file in `git status` and one
# `git add -A` away from the history.
*.log
# nohup output from the phase runs, and the scratch directories Hydra and
# tempfile leave behind. Same reason as the logs: they accumulate once per long
# run and only ever show up as noise in `git status`.
*.out
tmp*/

# Hydra
.hydra/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
